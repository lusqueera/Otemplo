DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Supabase: DB_SSLMODE=require; DB_POOLER=transaction só se usar a porta 6543
DB_SSLMODE=prefer
DB_POOLER=
DB_CONN_MAX_AGE=60



SECRET_KEY=

DEBUG=

ALLOWED_HOSTS=
# VPS atrás do nginx: BEHIND_PROXY=1; com domínio + certbot: SECURE_SSL=1
BEHIND_PROXY=0
SECURE_SSL=0

CORS_ALLOWED_ORIGINS=

# Supabase Storage (S3) — deixe vazio para usar a pasta media/ local
SUPABASE_PROJECT_URL=https://<project-ref>.supabase.co
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=
SUPABASE_S3_BUCKET=media
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=

# E-mail (opcional; sem EMAIL_HOST as mensagens vão para o console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=

# DuckDNS + HTTPS (VPS)
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
CERTBOT_EMAIL=
